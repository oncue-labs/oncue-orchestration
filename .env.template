# Copy this file to .env.local for local development or .env.production for deployment.
# Never commit either copied file. Never put real secrets in this template.

MYSQL_DATABASE=oncue
MYSQL_USER=oncue
MYSQL_PASSWORD=oncue-local-password
MYSQL_ROOT_PASSWORD=oncue-local-root-password
MYSQL_PORT=3306

REDIS_HOST=redis
REDIS_PORT=6379
BACKEND_PORT=8080
VOICE_PORT=8000
ONCUE_PUBLIC_HOST=192.168.200.109
ONCUE_DOCKER_SUBNET=172.30.0.0/24

JWT_SIGNING_SECRET=replace-with-a-local-development-secret
REFRESH_TOKEN_TTL=720h
VOICE_INTERNAL_SERVICE_TOKEN=replace-with-local-voice-token
ONCUE_AUTH_X_CLIENT_ID=replace-with-a-local-x-client-id
ONCUE_AUTH_X_CLIENT_SECRET=replace-with-a-local-x-client-secret
X_REDIRECT_URI=com.oncue.oncuemobile://oauth/x/callback
ONCUE_LOCAL_TEST_CALL_ENABLED=true

# Keep the RSA private key out of Git. Use literal \\n sequences when storing PEM text here.
VOICE_JWT_PRIVATE_KEY=
ONCUE_VOICE_JWT_PUBLIC_KEY=

APNS_KEY_ID=replace-with-local-apns-key-id
APNS_TEAM_ID=replace-with-local-apple-team-id
APNS_BUNDLE_ID=com.oncue.oncueMobile
APNS_SECRET_DIR_HOST=./.secrets

ONCUE_EVALUATION_PROVIDER=fake
ONCUE_VOICE_RUNTIME=realtime
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_VOICE_ID=alloy
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy

ONCUE_TURN_REALM=oncue.local
TURN_USERNAME=oncue-local
TURN_CREDENTIAL=replace-with-a-local-turn-credential
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_RELAY_PORT_START=50000
TURN_RELAY_PORT_END=50048
ONCUE_TURN_MIN_PORT=50000
ONCUE_TURN_MAX_PORT=50048
