# Local development only. Never use these values in production.

MYSQL_DATABASE=oncue
MYSQL_USER=oncue
MYSQL_PASSWORD=oncue-local-password
MYSQL_ROOT_PASSWORD=oncue-local-root-password
MYSQL_PORT=3306

REDIS_HOST=redis
REDIS_PORT=6379
BACKEND_PORT=8080
VOICE_PORT=8000

# Replace this before starting the backend. It must be a sufficiently long secret.
JWT_SIGNING_SECRET=replace-with-a-local-development-secret
VOICE_INTERNAL_SERVICE_TOKEN=replace-with-a-local-voice-token

# The connection token uses an RSA key pair separate from the login-token secret.
# Use the same key pair in both services. Keep literal \n sequences if the PEM is stored in this file.
VOICE_JWT_PRIVATE_KEY=
ONCUE_VOICE_JWT_PUBLIC_KEY=

# Backend connection-token response settings for local mobile testing.
# The signaling URL must be reachable from the host or simulator.
ONCUE_VOICE_SIGNALING_URL=ws://localhost:8000/v1/signaling

# Public provider is the default. The key is intentionally empty in the example.
ONCUE_EVALUATION_PROVIDER=fake
ONCUE_VOICE_RUNTIME=realtime
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_VOICE_ID=alloy
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy

# coturn configuration is owned by oncue-voice/docker/turn.
ONCUE_TURN_REALM=oncue.local
TURN_USERNAME=oncue-local
TURN_CREDENTIAL=replace-with-a-local-turn-credential
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_RELAY_PORT_START=49152
TURN_RELAY_PORT_END=49200
ONCUE_TURN_MIN_PORT=49152
ONCUE_TURN_MAX_PORT=49200
